# Sorgente del download della lista vini.
# true  -> scarica il PDF locale servito da Netlify (/WineList.pdf, file in public/WineList.pdf)
# false -> usa il link Google Drive definito in public/locales/{it,en}/common.json
#
# Su Netlify imposta questa variabile in Site configuration -> Environment variables
# (scope "Builds") e rilancia il deploy. La variabile e' letta al momento del build.
PUBLIC_WINE_LIST_LOCAL=false
