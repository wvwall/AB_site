# Login della pagina /admin/lista-vini (upload della lista vini).
# Su Netlify imposta queste variabili in Site configuration -> Environment variables
# con scope "Functions", poi rilancia il deploy.
# In locale serve `netlify dev` (le function e Netlify Blobs non girano con `astro dev`).

# OAuth Client ID di Google (Google Cloud Console -> Credentials, tipo "Web application").
# Non e' un segreto.
GOOGLE_CLIENT_ID=

# Email Google autorizzate a caricare la lista, separate da virgola.
ALLOWED_EMAILS=

# Segreto per firmare la sessione. Almeno 32 caratteri casuali: `openssl rand -base64 32`
SESSION_SECRET=
