---
import { t, type Language } from "../i18n";
import { icon } from "@fortawesome/fontawesome-svg-core";
import { faWhatsapp } from "@fortawesome/free-brands-svg-icons";
import { ChevronRight, Download } from "lucide-astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const whatsappIconSvg = icon(faWhatsapp).html.join("");

// Fallback locale attivabile via variabile d'ambiente (Netlify / .env).
// true  -> serve il PDF locale /WineList.pdf (public/WineList.pdf)
// false -> usa il link Google Drive definito nelle traduzioni
const wineListHref =
  import.meta.env.PUBLIC_WINE_LIST_LOCAL === "true"
    ? "/WineList.pdf"
    : t(lang, "hero.wineListUrl");
---

<main
  class="relative flex flex-col items-center overflow-hidden bg-blackMain md:min-h-screen">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_50%_30%_at_50%_95%,rgba(0,158,145,0.07),transparent_70%)] [animation:hero-glow-drift_16s_ease-in-out_infinite]" aria-hidden="true"></div>
  <div class="relative grid items-center w-[calc(100%-40px)] max-w-[1536px] pt-16 pb-20 gap-6 md:max-[1023px]:w-[min(640px,calc(100%-64px))] md:max-[1023px]:py-20 md:max-[1023px]:gap-8 min-[1024px]:grid-cols-[60%_40%] min-[1024px]:w-[82%] min-[1024px]:min-h-[80svh] min-[1024px]:py-16 min-[1024px]:gap-0">
    <div class="min-w-0 text-center min-[1024px]:text-left min-[1024px]:relative min-[1024px]:-top-10 min-[1024px]:pr-[clamp(32px,4.6vw,84px)]">
      <div class="relative">
        <div class="pointer-events-none absolute left-[calc(50%-50vw)] top-[calc(50%-30svh)] w-screen h-[100svh]" aria-hidden="true">
          <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_45%_at_50%_30%,rgba(87,14,39,0.35),transparent_70%)] [animation:hero-glow-drift_16s_ease-in-out_infinite]"></div>
        </div>
        <h1 class="relative reveal-down playfair-display-sc-black text-white text-[clamp(32px,12vw,75px)] leading-[0.8] tracking-[0.01em] whitespace-nowrap min-[1024px]:text-[clamp(60px,6.15vw,118px)]">
          <span class="block mb-[0.12em] text-[1.5em] playfair-display-sc-black">{t(lang, "hero.brandLetter")}</span>
          {t(lang, "hero.brandName")}
        </h1>
      </div>
    </div>
    <div class="min-w-0 border-[#570e2880] min-[1024px]:flex min-[1024px]:flex-col min-[1024px]:justify-center min-[1024px]:min-h-[clamp(360px,53svh,520px)] min-[1024px]:pt-0 min-[1024px]:pl-[clamp(32px,4.6vw,84px)] min-[1024px]:border-t-0 min-[1024px]:border-l ">
      <p class="reveal-pulse m-0 text-center min-[1024px]:text-left text-gray-400 text-[14px] font-light tracking-wide leading-relaxed text-pretty min-[640px]:text-[18px] ">
        {t(lang, "hero.description")}
      </p>
      <div class="grid gap-3 mt-10 min-[1024px]:gap-4 min-[1024px]:mt-7">
        <a
          class="group btn-shine reveal-left flex items-center gap-4 w-full min-h-16 py-3 px-5 min-[1024px]:min-h-20 min-[1024px]:py-4 rounded-[7px] border border-[#8b1943] bg-[#570e27] text-gray-300 no-underline uppercase transition-[background-color,border-color] duration-200 ease-[ease] hover:bg-[#7a1835] hover:border-[#a82855] min-[1024px]:gap-6 min-[1024px]:px-[clamp(20px,1.8vw,32px)] motion-reduce:transition-none"
          href={wineListHref}
          download={t(lang, "hero.wineListFileName")}>
          <span class="inline-flex shrink-0 items-center justify-center w-9 h-9 border border-white/10 rounded-lg [&>svg]:w-[22px] [&>svg]:h-[22px] min-[1024px]:w-11 min-[1024px]:h-11 min-[1024px]:[&>svg]:w-[26px] min-[1024px]:[&>svg]:h-[26px]">
            <Download size={26} aria-hidden="true" />
          </span>
          <span class="flex flex-col gap-0 min-w-0 leading-[1.25]">
            <span class="text-[14px] md:text-[16px] font-semibold">{t(lang, "hero.wineListButton")}</span>
            <span class="text-gray-400 text-[10px] md:text-[11px] font-normal tracking-wide">{t(lang, "hero.wineListSubtitle")}</span>
          </span>
          <ChevronRight class="shrink-0 ml-auto transition-transform duration-200 ease-[ease] group-hover:translate-x-[3px] motion-reduce:transition-none" size={22} aria-hidden="true" />
        </a>
        <a
          class="group btn-shine reveal-right flex items-center gap-4 w-full min-h-16 py-3 px-5 min-[1024px]:min-h-20 min-[1024px]:py-4 rounded-[7px] border border-[#353535] bg-blackFooter text-gray-300 no-underline uppercase transition-[background-color,border-color] duration-200 ease-[ease] hover:bg-[#1d1d1d] hover:border-[#686868] min-[1024px]:gap-6 min-[1024px]:px-[clamp(20px,1.8vw,32px)] motion-reduce:transition-none"
          title={t(lang, "hero.whatsappTitle")}
          target="_blank"
          rel="noopener noreferrer"
          href={t(lang, "hero.whatsappUrl")}>
          <span class="inline-flex shrink-0 items-center justify-center w-9 h-9 border border-white/10 rounded-lg [&>svg]:w-[22px] [&>svg]:h-[22px] min-[1024px]:w-11 min-[1024px]:h-11 min-[1024px]:[&>svg]:w-[26px] min-[1024px]:[&>svg]:h-[26px]" aria-hidden="true" set:html={whatsappIconSvg} />
          <span class="flex flex-col gap-0 min-w-0 leading-[1.25]">
            <span class="text-[14px] md:text-[16px] font-semibold">{t(lang, "hero.whatsappButton")}</span>
            <span class="text-gray-400 text-[10px] md:text-[11px] font-normal tracking-wide">{t(lang, "hero.whatsappSubtitle")}</span>
          </span>
          <ChevronRight class="shrink-0 ml-auto transition-transform duration-200 ease-[ease] group-hover:translate-x-[3px] motion-reduce:transition-none" size={22} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</main>
