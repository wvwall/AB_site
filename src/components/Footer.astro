---
import { t, type Language } from "../i18n";
import SocialIcon from "./SocialIcon.astro";
import { faInstagram, faThreads } from "@fortawesome/free-brands-svg-icons";
import { Cookie, ChevronDown } from "lucide-astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  id="contatti"
  class="rounded-md border border-[rgba(255,255,255,0.14)] m-4 shadow-[0_8px_32px_rgba(0,0,0,0.3)] overflow-hidden">
  <div class="flex flex-col items-center bg-blackFooter">
    <h2
      class="my-6 text-2xl tracking-wider text-gray-300 playfair-display-sc-bold md:my-8">
      {t(lang, "footer.contactsTitle")}
    </h2>
    <hr
      class="h-px border-0 w-[90%] bg-gradient-to-r from-transparent via-zinc-700 to-transparent" />
    <div
      class="flex flex-col md:flex-row my-5 md:my-8 md:mr-[25px] justify-center items-center gap-6 md:gap-12 text-sm">
      <a
        href="mailto:info@abwinetrader.com"
        class="relative text-gray-300 hover:text-white transition-colors duration-300 after:content-[''] after:absolute after:bottom-[-2px] after:left-0 after:w-0 after:h-px after:bg-white after:transition-[width] after:duration-300 hover:after:w-full"
        >{t(lang, "footer.email")}</a
      >

      <div class="flex gap-3">
        <SocialIcon
          ariaLabel={t(lang, "footer.instagramLabel")}
          href="https://www.instagram.com/ab_luxury_wine/"
          icon={faInstagram}
        />

        <!-- TikTok Icon
        <a
          aria-label="TikTok"
          href="https://www.tiktok.com/@ab_luxury_wine?_t=ZN-8uNMCOOkPAs&_r=1"
          target="_blank"
          class="inline-flex items-center justify-center w-[42px] h-[42px] rounded-full border border-[rgba(255,255,255,0.08)] text-gray-300 hover:text-white hover:bg-[rgba(255,255,255,0.07)] hover:-translate-y-[3px] hover:border-[rgba(255,255,255,0.2)] transition-all duration-300">
          <i class="text-2xl fa-brands fa-tiktok"></i>
        </a> -->

        <SocialIcon
          ariaLabel={t(lang, "footer.threadsLabel")}
          href="https://www.threads.net/@ab_luxury_wine?igshid=NTc4MTIwNjQ2YQ=="
          icon={faThreads}
        />
      </div>

      <span
        class="relative text-gray-300 hover:text-white transition-colors duration-300 after:content-[''] after:absolute after:bottom-[-2px] after:left-0 after:w-0 after:h-px after:bg-white after:transition-[width] after:duration-300 hover:after:w-full"
        >{t(lang, "footer.phone")}</span
      >
    </div>
  </div>

  <div class="px-4 pt-6 pb-4 text-center bg-blackFooter">
    <small class="text-[10px] text-gray-300">
      {t(lang, "footer.copyright").replace("{year}", currentYear.toString())}
    </small>
  </div>
  <div class="px-6 pt-2 pb-4 text-center bg-blackFooter">
    <button
      id="cookieToggle"
      class="flex items-center justify-center gap-1 mx-auto cursor-pointer bg-transparent border-0 text-gray-400 hover:text-gray-300 text-[10px] leading-relaxed p-1 transition-colors duration-300"
      aria-expanded="false"
      aria-controls="cookieText">
      <Cookie class="h-3.5 w-3.5" />
      <span>{t(lang, "footer.cookieButtonLabel")}</span>
      <span
        id="cookieChevron"
        class="transition-transform duration-300 ease-in-out"
        aria-hidden="true">
        <ChevronDown class="h-3 w-3" />
      </span>
    </button>
    <div
      id="cookieText"
      class="overflow-hidden transition-all duration-300 ease-in-out max-h-0">
      <p
        class="text-[10px] leading-relaxed text-gray-400 max-w-5xl mx-auto"
        set:html={t(lang, "footer.cookieText")}>
      </p>
    </div>
  </div>
</footer>
