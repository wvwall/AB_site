---
import { t, type Language } from "../i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<header
  class="rounded-md backdrop-blur-xl bg-[rgba(18,18,18,0.7)] border border-[rgba(255,255,255,0.08)] m-4 shadow-[0_8px_32px_rgba(0,0,0,0.3)] transition-all duration-300">
  <nav class="flex items-center justify-between px-4 py-4 md:px-12">
    <div class="flex items-center">
      <img
        src="/assets/img/logo-no-testo.png"
        alt={t(lang, "header.logoAlt")}
        class="h-[35px] w-[12px] mr-2"
        width="278"
        height="782" />
      <span class="text-xl text-gray-300 playfair-display-sc-bold"
        >{t(lang, "header.brandName")}
      </span>
    </div>
    <div class="flex items-center sm:gap-1">
      <a
        href="https://g.co/kgs/V7LW5z2"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t(lang, "header.locationLink")}
        class="rounded-md px-3 h-8 border border-[rgba(255,255,255,0.08)] flex items-center gap-1 text-gray-300 hover:bg-[rgba(255,255,255,0.07)] transition-colors duration-300 group">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform duration-300">
          <path
            d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
          <circle cx="12" cy="10" r="1" />
        </svg>
        <span class="hidden mb-1 playfair-display-sc-bold md:block"
          >{t(lang, "header.locationLink")}</span
        >
      </a>
      <div class="flex items-center justify-end space-x-2">
        <input
          type="checkbox"
          name="toggle"
          id="toggle"
          aria-label={t(lang, "header.languageToggle")}
          class="sr-only" />
        <label for="toggle">
          <span
            class="rounded-md flex items-center h-8 p-1 cursor-pointer w-11 bg-zinc-800 border border-[rgba(255,255,255,0.08)]">
            <span
              class="rounded-sm w-6 h-6 duration-300 ease-in-out transform bg-white shadow-xl toggle-dot"></span>
          </span>
        </label>
      </div>
    </div>
  </nav>
</header>
