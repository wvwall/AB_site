---
import { t, type Language } from "../i18n";
import { Store, Globe } from "lucide-astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<header
  class="rounded-md bg-blackFooter border border-[rgba(255,255,255,0.08)] m-4 shadow-[0_8px_32px_rgba(0,0,0,0.3)] transition-all duration-300">
  <nav class="flex items-center justify-between px-4 py-4 md:px-12">
    <div class="flex items-center">
      <img
        src="/assets/img/logo-no-testo.png"
        alt={t(lang, "header.logoAlt")}
        class="h-[35px] w-[12px] mr-2"
        width="278"
        height="782" />
      <span class="text-xl text-gray-300 playfair-display-sc-bold"
        >{t(lang, "header.brandName")}
      </span>
    </div>
    <div class="flex items-center gap-2">
      <a
        href="https://g.co/kgs/V7LW5z2"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t(lang, "header.locationLink")}
        class="relative rounded-md px-3 h-8 border border-[rgba(255,255,255,0.08)] flex items-center gap-1 text-gray-300 hover:bg-[rgba(255,255,255,0.07)] transition-colors duration-300 group">
        <span
          class="absolute -top-2.5 left-1/2 -translate-x-1/2 rounded-full bg-[#570E27] px-1.5 py-[1px] text-[8px] font-semibold uppercase tracking-wider text-white border border-white/10 shadow-sm pointer-events-none">
          {t(lang, "header.shopBadge")}
        </span>
        <Store size={18} class="transition-transform duration-300" />
        <span class="hidden mb-1 playfair-display-sc-bold md:block"
          >{t(lang, "header.locationLink")}</span
        >
      </a>
      <div class="relative">
        <details class="lang-dropdown group">
          <summary
            aria-label={t(lang, "header.languageToggle")}
            class="list-none rounded-md px-3 h-8 border border-[rgba(255,255,255,0.08)] flex items-center gap-1.5 text-gray-300 hover:bg-[rgba(255,255,255,0.07)] transition-colors duration-300 cursor-pointer select-none">
            <Globe size={16} />
            <span class="text-sm uppercase playfair-display-sc-bold">{lang}</span>
          </summary>
          <div
            class="absolute right-0 top-[calc(100%+0.5rem)] w-32 rounded-md border border-[rgba(255,255,255,0.08)] bg-blackFooter shadow-[0_8px_24px_rgba(0,0,0,0.4)] overflow-hidden z-20">
            <a
              href="/"
              class={`block px-3 py-2 text-sm playfair-display-sc-bold text-gray-300 hover:bg-[rgba(255,255,255,0.07)] transition-colors duration-300 ${lang === "it" ? "bg-[rgba(255,255,255,0.05)]" : ""}`}>
              {t(lang, "header.languageIt")}
            </a>
            <a
              href="/en/"
              class={`block px-3 py-2 text-sm playfair-display-sc-bold text-gray-300 hover:bg-[rgba(255,255,255,0.07)] transition-colors duration-300 ${lang === "en" ? "bg-[rgba(255,255,255,0.05)]" : ""}`}>
              {t(lang, "header.languageEn")}
            </a>
          </div>
        </details>
      </div>
    </div>
  </nav>
</header>
